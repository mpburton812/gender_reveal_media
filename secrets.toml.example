# Copy to `.streamlit/secrets.toml` locally (never commit secrets).
# Streamlit Community Cloud: paste the same keys in App secrets.
# Local CLI ingest: pip install -r requirements-ingest.txt
#
# Required for the Streamlit UI: TURSO_DATABASE_URL, TURSO_AUTH_TOKEN
# Turso (*.turso.io): GitHub Actions and Streamlit (default) coerce libsql:// or wss:// to https://
# for reliable libsql-client HTTP transport. Set TURSO_USE_WEBSOCKET=1 to force libsql/wss instead.
# Optional for the UI: GEMINI_API_KEY (only needed if you run Gemini from Streamlit later)
# Optional: GEMINI_MODEL (default gemini-2.5-flash; gemini-2.0-flash is remapped automatically)
# Optional: INGEST_MAX_EPISODES / INGEST_EPISODES_CAP for CLI/local (GitHub Actions uses workflow input)
# Optional sidebar links: PATREON_URL, MERCH_URL
# Optional: ITUNES_PODCAST_ID (default 1330522019 — Gender Reveal on Apple Podcasts)
# Optional media link search (populate-links / ingest --populate-links):
#   No API keys required for: books (Open Library), music/artists (MusicBrainz),
#   publications (OpenAlex), zines (Internet Archive).
#   TMDB_API_KEY (or THEMOVIEDB_API_KEY) for movies and tv shows (themoviedb.org).
#   Optional fallback for games, graphic novels, etc.: GOOGLE_CSE_API_KEY + GOOGLE_CSE_CX
#   MEDIA_LINK_SEARCH_SLEEP_SEC (default 1.0; use >=1.0 for MusicBrainz), MEDIA_LINK_SEARCH_LIMIT

GEMINI_API_KEY = ""
TURSO_DATABASE_URL = ""
TURSO_AUTH_TOKEN = ""

# Optional: official show links for the sidebar
PATREON_URL = ""
MERCH_URL = ""

# TMDB_API_KEY = ""
# GOOGLE_CSE_API_KEY = ""
# GOOGLE_CSE_CX = ""
