# Copy to `.streamlit/secrets.toml` locally (never commit secrets).
# Streamlit Community Cloud: paste the same keys in App secrets.
# Local CLI ingest: pip install -r requirements-ingest.txt
#
# Required for the Streamlit UI: TURSO_DATABASE_URL, TURSO_AUTH_TOKEN
# Turso: use the dashboard libsql:// URL as-is for GitHub Actions (wss).
# If your GitHub secret is https://… (Turso’s HTTPS URL), it is rewritten to libsql:// on Actions.
# The Streamlit app sets TURSO_PREFER_HTTPS=1 by default so hosted Streamlit uses https.
# Override with TURSO_PREFER_HTTPS=0 or TURSO_USE_WEBSOCKET=1 if needed.
# Optional for the UI: GEMINI_API_KEY (only needed if you run Gemini from Streamlit later)
# Optional sidebar links: PATREON_URL, MERCH_URL

GEMINI_API_KEY = ""
TURSO_DATABASE_URL = ""
TURSO_AUTH_TOKEN = ""

# Optional: official show links for the sidebar
PATREON_URL = ""
MERCH_URL = ""
